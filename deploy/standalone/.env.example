# Copy to .env. Choose unique storage credentials before the first start.
STORAGE_ACCESS_KEY=openseo
STORAGE_SECRET_KEY=replace-with-a-long-random-secret
# password: email and password accounts. The first visitor creates the
# admin account; invitations add the rest.
# local_noauth: no sign-in and one admin user, as the old Docker image ran;
# only for private networks.
AUTH_MODE=password

# Recurring plain HTTP audits remain unavailable until a finite policy is set.
# No provider keys here; rendering and Lighthouse recurrence are unavailable.
# Example: {"version":1,"maxRunsPerUtcDay":2,"maxPagesPerUtcDay":100,"maxCostMicrosPerUtcDay":0,"maxConcurrentRuns":1,"providers":{}}
AUDIT_RECURRING_POLICY=
# The public URL of this installation, in either mode.
BETTER_AUTH_URL=http://localhost:3001
PORT=3001
# Optional feature credentials; these are set at initialization, never compiled.
DATAFORSEO_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
LEGACY_SETUP_CUTOVER_VERIFIED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CONTEXT_API_KEY=

# Optional Google sign-in via your Firebase Auth project (public web config).
# Existing users link from personal settings; new Google users need invitations.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
